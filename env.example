# Copy this to .env and fill in real values there. Never commit .env or
# paste real secrets into chat/tickets - .env is already gitignored.

# ============================================================
# REQUIRED - nothing runs without these
# ============================================================

# Which broker backend actually executes trades - "alpaca" (default) or
# "tradier". Only Alpaca supports native bracket (take_profit/stop_loss)
# orders server-side; under Tradier, exits are watched and submitted
# actively instead (see lavish_core/trade/equity_exit_monitor.py's
# watch_and_exit_active) - this is handled automatically, nothing else to
# configure for that difference.
BROKER_PROVIDER=alpaca

# Alpaca PAPER keys (from a paper trading account, not live) -
# app.alpaca.markets -> Paper Trading -> API Keys. Only needed if
# BROKER_PROVIDER=alpaca.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# Tradier sandbox token (developer.tradier.com -> Sandbox account) - only
# needed if BROKER_PROVIDER=tradier. TRADIER_ACCOUNT_ID is optional; if
# unset, the first account returned by this token's /user/profile is used.
# TRADIER_BASE_URL defaults to the sandbox - point it at
# https://api.tradier.com/v1 for production/live.
TRADIER_API_KEY=
TRADIER_ACCOUNT_ID=
TRADIER_BASE_URL=https://sandbox.tradier.com/v1

# Must be explicit - defaults to "dry" (parses alerts, logs what it would
# do, submits nothing) if unset. Only "paper" or "live" actually place
# orders; TRADE_MODE=live requires ALPACA_BASE_URL (or TRADIER_BASE_URL,
# if BROKER_PROVIDER=tradier) pointed at the live endpoint too, not just
# this flag.
TRADE_MODE=paper

# Patreon - requires an OAuth token with campaigns.posts scope AND actual
# permission to read the configured campaign's posts. Paid membership alone
# does not verify API access. Confirm a successful read before enabling trades.
# Provide PATREON_ACCESS_TOKEN plus refresh-flow credentials for token rotation:
PATREON_ACCESS_TOKEN=
PATREON_CAMPAIGN_ID=
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=
PATREON_REFRESH_TOKEN=

# ============================================================
# Ticker whitelist - REVIEW THIS before turning paper on
# ============================================================
# Only tickers on this list are ever treated as tradeable symbols (this is
# the fix for the "PRINT/BIG/TODAY get traded as tickers" bug). The default
# below reflects every real ticker actually confirmed in her alerts across
# this whole project (screenshots reviewed directly, not guessed) - SPY,
# QQQ, AAPL, TSLA, NVDA, AMD, META, MU, MSTR, HOOD, ATAI, NVO, UNH, NFLX,
# AMZN, DDOG and others. Still review it yourself before going live - this
# list is only as current as the last screenshot it was checked against.
# If a real ticker isn't on this list, that alert is silently skipped -
# expand this to match what she actually calls, or alerts you're expecting
# to see acted on won't be.
WHITELIST_TICKERS=AAPL,MSFT,AMD,NVDA,META,TSLA,SPY,QQQ,GOOGL,CRM,MSTR,MU,HOOD,ATAI,NVO,UNH,AVGO,CRWV,NFLX,AMZN,DDOG

# ============================================================
# Discord - OPTIONAL. Leave all three unset to run Patreon-only.
# Read lavish_core/discord_ingest/listener.py's module docstring before
# setting these - this is a real ToS/account-risk decision, not a
# config toggle to flip casually.
# ============================================================
DISCORD_USER_TOKEN=
DISCORD_INGEST_ACCEPT_TOS_RISK=0
DISCORD_WATCH_CHANNEL_IDS=

# ============================================================
# Alerting - OPTIONAL but strongly recommended once paper is on.
# Without this, circuit-breaker trips, failed exit orders, and recovered
# crashed positions only show up in log files - nobody gets notified.
# Any Discord webhook URL works (Server Settings -> Integrations ->
# Webhooks -> New Webhook), doesn't need to be in her server at all.
# ============================================================
DISCORD_WEBHOOK_URL=

# ============================================================
# Everything below has a working default - only change if you want to
# tune it.
# ============================================================

# Position sizing (dollars per trade; PATRON_DOLLARS overrides
# DEFAULT_TRADE_DOLLARS for Patreon-sourced equity signals specifically)
DEFAULT_TRADE_DOLLARS=500
DEFAULT_OPTION_TRADE_DOLLARS=200
PATRON_DOLLARS=

# Candle-confirmation gate - before any new entry (equity BUY, or any
# options open) places a real order, this watches 1-minute bars for a
# real close beyond the alert-time candle's wick in the alert's favor
# (volume is a secondary corroboration, not a hard requirement) before
# letting the order through. A SELL (closing/reducing an existing
# position) is never gated. See lavish_core/trade/candle_gatekeeper.py.
# Set to false to go back to firing orders the instant an alert parses.
GATEKEEPER_ENABLED=true
GATEKEEPER_MAX_WAIT_SECONDS=900
GATEKEEPER_POLL_INTERVAL_SEC=15
GATEKEEPER_VOLUME_CONFIRM_MULT=1.5
GATEKEEPER_VOLUME_LOOKBACK_BARS=10
GATEKEEPER_MAX_CONSECUTIVE_NO_DATA=4

# Equity bracket (only applied on the equity path - options trades use
# her stated target/stop directly, not these)
DEFAULT_STOP_LOSS_PCT=0.015
DEFAULT_TAKE_PROFIT_PCT=0.02

# Our own options exit guardrails - always active underneath her stated
# target/stop (when she gives one), and the entire exit plan when she
# doesn't. See lavish_core/trade/options_exit_monitor.py.
OPTIONS_OWN_STOP_LOSS_PCT=0.50
OPTIONS_OWN_TRAIL_TRIGGER_PCT=0.30
OPTIONS_OWN_TRAIL_DRAWDOWN_PCT=0.20
OPTIONS_EXPIRY_FORCE_CLOSE_MINUTES=30
OPTIONS_EXIT_MAX_MONITOR_HOURS=8
OPTIONS_EXIT_POLL_INTERVAL_SEC=5

# Crash recovery - how often to check for open positions with no active
# guardrail monitor in this process (e.g. after a restart)
RECONCILE_INTERVAL_SECONDS=120

# How often to snapshot account equity/cash/buying_power/day P&L into
# account_snapshots for historical tracking (seconds)
ACCOUNT_SNAPSHOT_INTERVAL_SECONDS=900

# Circuit breaker
DAILY_LOSS_LIMIT_PCT=0.03
WEEKLY_LOSS_LIMIT_PCT=0.07
MAX_CONSECUTIVE_LOSSES=5

# Portfolio concentration - blocks a new buy if this many *other* open
# positions are already in the same correlation group (see
# lavish_core/trade/portfolio_risk.py for the default grouping). Override
# the grouping with CORRELATION_GROUPS_JSON, e.g. {"IBM":"mega_tech"}.
MAX_CORRELATED_POSITIONS=3
CORRELATION_GROUPS_JSON=

# Options entry fill confirmation (mirrors the equity path's fill poll)
OPTIONS_FILL_POLL_ATTEMPTS=5
OPTIONS_FILL_POLL_INTERVAL_SEC=1.0

# Equity bracket exit tracking - how often to poll the take_profit/
# stop_loss child legs for a fill, and how long to keep watching before
# giving up (a day order's own TIF already bounds this to one session)
EQUITY_EXIT_POLL_INTERVAL_SEC=15
EQUITY_EXIT_MAX_MONITOR_HOURS=12

# Staged capital rollout - scales every computed position size (equity
# dollars, option dollars) without touching DEFAULT_TRADE_DOLLARS/
# DEFAULT_OPTION_TRADE_DOLLARS directly. Start real money at 0.1-0.25 and
# ramp toward 1.0 as live performance confirms the bot.
POSITION_SIZE_SCALE=1.0

# Signal quality / matching
SIGNAL_CONFIDENCE_FLOOR=0.55
OPTION_STRIKE_TOLERANCE=5

# Reject an options trade if bid/ask spread is more than this fraction of
# the mid price - a thin/illiquid contract's "mid" isn't a fair fill on
# either side (a real example: bid $23 / ask $2,690 on one contract)
OPTION_MAX_SPREAD_PCT=0.50

# Pattern Day Trader guard - a margin account under this equity that hits
# PDT_MAX_DAY_TRADES same-day round trips in PDT_LOOKBACK_BUSINESS_DAYS
# blocks new entries (never exits) rather than risk a FINRA PDT flag and
# a 90-day freeze. Set PDT_EQUITY_THRESHOLD=0 to disable (cash account,
# or already well above $25k).
PDT_EQUITY_THRESHOLD=25000
PDT_MAX_DAY_TRADES=3
PDT_LOOKBACK_BUSINESS_DAYS=5
SIGNAL_DEDUP_WINDOW_SECONDS=300

# Circuit breaker, PDT guard, and the correlation check all block new
# entries by default if they can't read the account/positions from the
# broker ("can't verify we're safe" means no, not yes). Set to true only
# if you have a real reason to prefer the old behavior of allowing trades
# through during a broker outage - exits are never affected either way.
RISK_CHECK_FAIL_OPEN=false

# Reject a trade if the underlying has already moved more than this much
# (fraction) since the alert's own post timestamp - a late-processed
# alert (bot was slow, or catching up after downtime) shouldn't trade at
# a price meaningfully different from what she actually saw when she
# posted it. 0 disables the check.
MAX_PRICE_DRIFT_SINCE_ALERT_PCT=0.03

# Patreon posts older than this when first seen are skipped (not traded,
# still marked seen) - catching up on a backlog after downtime shouldn't
# mean trading a post that's no longer "fresh."
PATREON_MAX_ALERT_AGE_SECONDS=900

# Patreon polling cadence (seconds)
PATREON_POLL_SECONDS=20
VISION_AUTO=true

# If the Patreon poller's own setup (resolving the campaign id, etc.)
# fails - a transient Patreon blip, a token refresh failing once - it
# restarts automatically after this many seconds rather than dying
# silently. Individual poll failures inside the running loop retry on
# their own much faster (PATREON_POLL_SECONDS); this only governs a
# full restart of the whole poller.
PATREON_RESTART_DELAY_SECONDS=30

# A new BUY submitted while the market is closed would otherwise sit
# queued at the broker and fill at the next open, at whatever price that
# turns out to be - after every risk check above already ran against a
# stale closed-market quote. Blocks new entries (never exits) outside
# market hours in paper/live; false disables this gate entirely.
REQUIRE_MARKET_OPEN=true

# How often run_ingest.py pings systemd's watchdog when running under
# the hardened deploy/lavish-bot.service unit (Type=notify). Must stay
# well under that unit's WatchdogSec (90s) - a no-op if not running
# under systemd.
WATCHDOG_PING_INTERVAL_SECONDS=30

# Fallback confidence score for an alert_handler.py code path that has no
# real confidence signal of its own to report.
ALERT_DEFAULT_CONFIDENCE=0.7

# Just a label attached to signals ingested via Discord, for the audit
# trail/dedup bookkeeping - not a real account identifier.
DISCORD_SIGNAL_SOURCE_NAME=discord

# Optional - HybridStore runs fine without Redis
REDIS_URL=

LOG_LEVEL=INFO

# Private signed text-alert receiver (optional alternative to Patreon/Discord).
# Generate locally with secrets.token_hex(32); never commit a real value.
ALERT_FEED_ENABLED=false
ALERT_FEED_EXECUTE=false
ALERT_FEED_HOST=127.0.0.1
ALERT_FEED_PORT=8877
ALERT_FEED_SECRET=
